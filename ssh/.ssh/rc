# ~/.ssh/rc — sshd runs this (via /bin/sh) on every incoming SSH connection,
# with SSH_AUTH_SOCK set to that connection's freshly-forwarded agent socket.
#
# Repoint a STABLE symlink (~/.ssh/agent.sock) at the live forwarded socket so
# long-lived tmux panes keep working across reconnects: a pane captures
# SSH_AUTH_SOCK at creation, and a forwarded socket's real path changes every
# connection. .zshrc sets SSH_AUTH_SOCK=~/.ssh/agent.sock (the stable symlink),
# and this rc keeps that symlink pointing at the newest connection's agent.
#
# Must stay silent on stdout (output here corrupts scp/sftp). Headless hosts
# only — this replaces sshd's default xauth handling, which is fine with no X11.
if test -S "$SSH_AUTH_SOCK" && test "$SSH_AUTH_SOCK" != "$HOME/.ssh/agent.sock"; then
  ln -sf "$SSH_AUTH_SOCK" "$HOME/.ssh/agent.sock"
fi
