#!/usr/bin/env bash
# Secret-scan guard for the dotfiles repo.
# Blocks a commit if any *staged* content looks like a credential.
# Enabled via: git config core.hooksPath git/hooks
#
# Bypass in a genuine false-positive with:  git commit --no-verify
set -euo pipefail

red()  { printf '\033[31m%s\033[0m\n' "$1"; }
bold() { printf '\033[1m%s\033[0m\n' "$1"; }

# High-signal patterns. Extended-regex, case-insensitive applied per-check.
patterns=(
  # AWS
  'AKIA[0-9A-Z]{16}'
  'aws_secret_access_key'
  # Private keys
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'
  # OpenAI / Anthropic / generic provider keys
  'sk-[A-Za-z0-9]{20,}'
  'sk-ant-[A-Za-z0-9_-]{20,}'
  # GitHub tokens
  'gh[pousr]_[A-Za-z0-9]{20,}'
  # Slack
  'xox[baprs]-[A-Za-z0-9-]{10,}'
  # Google API key
  'AIza[0-9A-Za-z_-]{35}'
  # Generic "key/token/secret/password = <longish value>"
  '(api[_-]?key|secret|token|passwd|password|bearer)["'"'"' ]*[:=]["'"'"' ]*[A-Za-z0-9/_+.=-]{16,}'
)

# Only scan added/modified staged text; ignore this hook and lockfiles.
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

found=0
while IFS= read -r file; do
  case "$file" in
    # Skip the hook itself and lockfiles. Claude memory/transcripts are
    # host-local and never tracked, so there's nothing under
    # claude/.claude/{memory,projects}/ to exclude here.
    git/hooks/pre-commit|*.lock|*lazy-lock.json) continue ;;
  esac
  # Diff of just this file's added lines (leading +), minus the +++ header.
  added=$(git diff --cached -- "$file" | grep -E '^\+' | grep -Ev '^\+\+\+' || true)
  [ -z "$added" ] && continue
  for pat in "${patterns[@]}"; do
    # Here-string (not a pipe): grep -q short-circuits on a match, which under
    # `set -o pipefail` would break the writer's pipe and MASK the match. A
    # here-string has no writer process, so detection is reliable on big files.
    if grep -Eiq -e "$pat" <<< "$added"; then
      if [ "$found" -eq 0 ]; then
        red "✖ Potential secret detected in staged changes — commit blocked."
        found=1
      fi
      bold "  $file"
      printf '    matched pattern: %s\n' "$pat"
    fi
  done
done <<< "$staged"

if [ "$found" -ne 0 ]; then
  echo
  echo "Remove the secret (use 1Password / op run instead), or if this is a"
  echo "false positive, re-run with:  git commit --no-verify"
  exit 1
fi
exit 0
